<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:converter="clr-namespace:Common_Wpf.Converter"
    xmlns:commonViewModel="clr-namespace:Common_Wpf.CommonViewModel"
    xmlns:commonEnums="clr-namespace:Common_Util.Data.Enums;assembly=Common_Util.Data"
    xmlns:util="clr-namespace:Common_Wpf.Utility"
    mc:Ignorable="d"
    xmlns:local_LayoutPanel="clr-namespace:Common_Wpf.Controls.LayoutPanel">

    <Style TargetType="{x:Type local_LayoutPanel:ActionButtonLayoutPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local_LayoutPanel:ActionButtonLayoutPanel}">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <!-- 上半部分：内容 -->
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <!-- 下半部分：按钮 -->
                            </Grid.RowDefinitions>

                            <!-- 上半部分：显示控件内部的 Content -->
                            <Border Grid.Row="0">
                                <ContentPresenter />
                            </Border>

                            <!-- 分隔符 -->
                            <Separator Grid.Row="1" Padding="0" Margin="0"/>

                            <!-- 下半部分：按钮区域 -->
                            <Border Grid.Row="2" Padding="{Binding ButtonAreaPadding, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl ItemsSource="{Binding DisplayButtons, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" 
                                                        ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType=local_LayoutPanel:ActionButtonLayoutPanel}, Path=ControlButtonTemplate}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>