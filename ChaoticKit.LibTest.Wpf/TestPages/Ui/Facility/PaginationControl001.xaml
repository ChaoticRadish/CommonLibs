<Page x:Class="ChaoticKit.LibTest.Wpf.TestPages.Ui.Facility.PaginationControl001"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChaoticKit.LibTest.Wpf.TestPages.Ui.Facility"
      xmlns:commonFG="clr-namespace:ChaoticKit.Wpf.Controls.FeatureGroup;assembly=ChaoticKit.Wpf"
      xmlns:commonVB="clr-namespace:ChaoticKit.Wpf.Controls.ValueBox;assembly=ChaoticKit.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=local:PaginationControl001}"
      Title="PaginationControl001">

    <StackPanel Orientation="Vertical">
        <commonFG:PaginationControl x:Name="PaginationBox" Height="30" 
                                    OnPageChanged="PaginationBox_OnPageChanged"
                                    PageCode="{Binding ViewModel.PageCode, RelativeSource={RelativeSource AncestorType=local:PaginationControl001}}"
                                    TotalPage="{Binding ViewModel.TotalPage, RelativeSource={RelativeSource AncestorType=local:PaginationControl001}}"
                                    ContentLoadCommand="{Binding PageContentLoadAsyncCommand}"/>
        <TextBlock Text="{Binding PageNumberButtonAreaActualPixelWidth, ElementName=PaginationBox}"></TextBlock>
        <TextBlock>PageCode</TextBlock>
        <commonVB:IntInputer001 Value="{Binding PageCode, ElementName=PaginationBox}"></commonVB:IntInputer001>
        <TextBlock>TotalPage</TextBlock>
        <commonVB:IntInputer001 Value="{Binding TotalPage, ElementName=PaginationBox}"></commonVB:IntInputer001>
        <TextBlock></TextBlock>
        <CheckBox IsChecked="{Binding IsEnabled, ElementName=PaginationBox}">Enable</CheckBox>

        <TextBlock></TextBlock>
        <Separator/>
        <TextBlock>PageCode (Binding)</TextBlock>
        <TextBlock Text="{Binding ViewModel.PageCode, RelativeSource={RelativeSource AncestorType=local:PaginationControl001}}"></TextBlock>
        <TextBlock>TotalPage (Binding)</TextBlock>
        <TextBlock Text="{Binding ViewModel.TotalPage, RelativeSource={RelativeSource AncestorType=local:PaginationControl001}}"></TextBlock>

    </StackPanel>
</Page>
